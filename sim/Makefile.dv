# ICTC/Questa - one compile, many testcases. No UVM.
SHELL := /bin/bash
TESTNAME ?= register_reset_test
SEED ?= 1
TB_NAME ?= testbench
LOGDIR := log

.PHONY: all build run wave list clean
all: build run

build:
	@mkdir -p $(LOGDIR)
	@test -d work || vlib work
	vmap work work
	@bash -o pipefail -c 'vlog -sv -f compile.f 2>&1 | tee $(LOGDIR)/compile.log'

run:
	@mkdir -p $(LOGDIR)
	@bash -o pipefail -c 'vsim -c -sv_seed $(SEED) +TESTNAME=$(TESTNAME) -l $(LOGDIR)/$(TESTNAME)_$(SEED).transcript $(TB_NAME) -do "run -all; quit -f" 2>&1 | tee $(LOGDIR)/$(TESTNAME)_$(SEED).log'

wave:
	vsim -gui -sv_seed $(SEED) +TESTNAME=$(TESTNAME) $(TB_NAME) -do 'add wave -r sim:/$(TB_NAME)/*; run -all'

list:
	@grep -oE '"[a-z_0-9]+_test"' ../tb/testbench.sv | tr -d '"'

clean:
	rm -rf work transcript vsim.wlf vsim.db log *.ucdb
